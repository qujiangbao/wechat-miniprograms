.page {
  min-height: 100vh;
  background-color: #ffffff;
}

/* 轮播图。swiper 必须设置高度，否则区域高度为 0 */
.banner {
  width: 100%;
  height: 360rpx;
}

.banner-img {
  width: 100%;
  height: 360rpx;
}

/* 九宫格：横向换行，每项占三分之一 */
.nav {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: flex-start;
  align-items: flex-start;
  padding: 10rpx 0 40rpx;
}

.nav-item {
  width: 33.33%;
  box-sizing: border-box;
  padding: 28rpx 0 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.nav-icon {
  width: 96rpx;
  height: 96rpx;
}

.nav-name {
  margin-top: 14rpx;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.2;
}
