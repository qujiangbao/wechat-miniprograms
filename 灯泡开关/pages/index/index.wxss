.page {
  min-height: 100vh;
  background-color: #ffffff;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.bulb-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-bottom: 40rpx;
}

.bulb {
  width: 460rpx;
  height: 460rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.bulb.off {
  background-color: #e6e6e6;
}

.bulb.on.level-1 {
  background-color: #fff1a8;
}

.bulb.on.level-2 {
  background-color: #ffe56a;
}

.bulb.on.level-3 {
  background-color: #ffd400;
}

.bulb.on.level-4 {
  background-color: #ffc400;
}

.bulb.on.level-5 {
  background-color: #ffb300;
  box-shadow: 0 0 48rpx rgba(255, 179, 0, 0.45);
}

.bulb-icon {
  font-size: 52rpx;
  line-height: 1.2;
}

.bulb-text {
  margin-top: 12rpx;
  font-size: 30rpx;
  color: #333333;
}

.controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 36rpx calc(72rpx + env(safe-area-inset-bottom));
}

.dim-btn {
  min-width: 140rpx;
  padding: 20rpx 8rpx;
  text-align: center;
  font-size: 32rpx;
  color: #8d8d8d;
}

.dim-btn-hover {
  opacity: 0.55;
}

.switch-btn {
  min-width: 240rpx;
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 36rpx;
  text-align: center;
  background-color: #22c55e;
  color: #ffffff;
  font-size: 34rpx;
  border-radius: 12rpx;
}

.switch-btn-hover {
  background-color: #16a34a;
}

.toast {
  position: fixed;
  left: 50%;
  bottom: 220rpx;
  transform: translateX(-50%);
  max-width: 70%;
  padding: 16rpx 28rpx;
  background-color: rgba(0, 0, 0, 0.78);
  color: #ffffff;
  font-size: 26rpx;
  line-height: 1.4;
  border-radius: 10rpx;
  z-index: 10;
  pointer-events: none;
}
