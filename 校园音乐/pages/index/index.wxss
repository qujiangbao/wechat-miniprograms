.page {
  min-height: 100vh;
  background: #f3f6fb;
  padding-bottom: 48rpx;
  box-sizing: border-box;
}

.header {
  padding: 36rpx 32rpx 8rpx;
  background: linear-gradient(180deg, #d7e6ff 0%, #f3f6fb 100%);
}

.header-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1f2a37;
  line-height: 1.3;
}

.header-sub {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #8b95a5;
}

.now-card {
  margin-top: 28rpx;
  padding: 28rpx 28rpx 20rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(59, 110, 210, 0.08);
}

.now-main {
  display: flex;
  align-items: center;
}

.time-row {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
}

.time-text {
  width: 76rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  color: #8b95a5;
  font-variant-numeric: tabular-nums;
}

.time-text:last-child {
  text-align: right;
}

.progress {
  flex: 1;
  height: 8rpx;
  margin: 0 16rpx;
  border-radius: 999rpx;
  background: #e6ebf2;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: #3b82f6;
}

.controls {
  display: flex;
  align-items: flex-start;
  justify-content: space-around;
  margin-top: 24rpx;
}

.ctrl {
  width: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ctrl-circle {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #e8f1ff;
}

.ctrl-main {
  width: 96rpx;
  height: 96rpx;
  background: #3b82f6;
  box-shadow: 0 8rpx 18rpx rgba(59, 130, 246, 0.28);
}

.ctrl-label {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #5d6b7d;
}

.icon-play {
  width: 0;
  height: 0;
  margin-left: 6rpx;
  border-top: 16rpx solid transparent;
  border-bottom: 16rpx solid transparent;
  border-left: 24rpx solid #ffffff;
}

.icon-pause {
  width: 26rpx;
  height: 28rpx;
  background: linear-gradient(#ffffff, #ffffff) left / 8rpx 100% no-repeat, linear-gradient(#ffffff, #ffffff) right / 8rpx 100% no-repeat;
}

.icon-skip {
  position: relative;
  width: 0;
  height: 0;
  margin-left: 8rpx;
  border-top: 11rpx solid transparent;
  border-bottom: 11rpx solid transparent;
  border-left: 16rpx solid #3b82f6;
}

.icon-skip::before {
  content: "";
  position: absolute;
  top: -11rpx;
  left: -22rpx;
  border-top: 11rpx solid transparent;
  border-bottom: 11rpx solid transparent;
  border-left: 16rpx solid #3b82f6;
}

.icon-skip::after {
  content: "";
  position: absolute;
  top: -12rpx;
  left: 4rpx;
  width: 4rpx;
  height: 24rpx;
  border-radius: 2rpx;
  background: #3b82f6;
}

.icon-prev {
  transform: scaleX(-1);
  margin-left: 0;
  margin-right: 8rpx;
}

.note-box {
  width: 96rpx;
  height: 96rpx;
  margin-right: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 22rpx;
  background: #e8f1ff;
  color: #3b82f6;
  font-size: 52rpx;
  line-height: 1;
}

.now-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2a37;
}

.now-artist {
  margin-top: 6rpx;
  font-size: 26rpx;
  color: #8b95a5;
}

.now-tag {
  display: inline-block;
  margin-top: 14rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: #e8f1ff;
  color: #3b82f6;
  font-size: 22rpx;
  line-height: 1.6;
}

.panel {
  margin: 20rpx 32rpx 0;
  padding: 28rpx 20rpx 12rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 42, 55, 0.04);
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 12rpx 8rpx;
}

.panel-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2a37;
}

.panel-count {
  font-size: 24rpx;
  color: #9aa3b2;
}

.song-scroll {
  height: 560rpx;
}

.song-item {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
  padding: 20rpx 12rpx;
  border-radius: 16rpx;
}

.song-item.active {
  background: #eef5ff;
}

.song-index {
  width: 52rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: #9aa3b2;
}

.song-meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.song-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2a37;
}

.song-artist {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #9aa3b2;
}

.song-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 8rpx 4rpx;
  color: #3b82f6;
  font-size: 26rpx;
}

.song-btn-on {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #3b82f6;
  color: #ffffff;
  font-size: 24rpx;
}

.volume-panel {
  padding-bottom: 20rpx;
}

.volume-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #3b82f6;
}

.volume-slider {
  margin: 12rpx 16rpx 0;
}

.volume-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4rpx 16rpx 8rpx;
  color: #9aa3b2;
  font-size: 24rpx;
}

.volume-tip {
  color: #3b82f6;
  font-weight: 600;
}

.volume-tip.mute {
  color: #8b95a5;
}
