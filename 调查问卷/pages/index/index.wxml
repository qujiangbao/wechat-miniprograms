<view class="page">
  <block wx:if="{{!submitSuccess}}">
    <view class="form-card" wx:if="{{formVisible}}">
      <text class="title">学生信息调查问卷</text>

      <!-- 姓名 -->
      <view class="form-item">
        <text class="label">姓名</text>
        <input
          class="input {{errors.name ? 'invalid' : ''}}"
          value="{{form.name}}"
          placeholder="请输入真实姓名"
          placeholder-class="placeholder"
          maxlength="20"
          bindinput="onNameInput"
          bindblur="validateName"
        />
        <text class="error" wx:if="{{errors.name}}">{{errors.name}}</text>
      </view>

      <!-- 性别 -->
      <view class="form-item">
        <text class="label">性别</text>
        <radio-group class="choice-row" bindchange="onGenderChange">
          <label class="choice-item" wx:for="{{genderOptions}}" wx:key="value">
            <radio value="{{item.value}}" checked="{{item.checked}}" color="#07c160" />
            <text>{{item.name}}</text>
          </label>
        </radio-group>
        <text class="error" wx:if="{{errors.gender}}">{{errors.gender}}</text>
      </view>

      <!-- 学历 -->
      <view class="form-item">
        <text class="label">学历</text>
        <radio-group class="choice-row" bindchange="onEducationChange">
          <label class="choice-item" wx:for="{{eduOptions}}" wx:key="value">
            <radio value="{{item.value}}" checked="{{item.checked}}" color="#07c160" />
            <text>{{item.name}}</text>
          </label>
        </radio-group>
      </view>

      <!-- 专业技能 -->
      <view class="form-item">
        <text class="label">专业技能</text>
        <checkbox-group class="choice-row" bindchange="onSkillsChange">
          <label class="choice-item" wx:for="{{skillOptions}}" wx:key="value">
            <checkbox value="{{item.value}}" checked="{{item.checked}}" color="#07c160" />
            <text>{{item.name}}</text>
          </label>
        </checkbox-group>
      </view>

      <!-- 学习意见 -->
      <view class="form-item">
        <text class="label">学习意见（不少于10字）</text>
        <view class="textarea-wrap {{errors.opinion ? 'invalid' : ''}}">
          <textarea
            class="textarea"
            value="{{form.opinion}}"
            placeholder="请输入你对本课程的意见和建议"
            placeholder-class="placeholder"
            maxlength="200"
            disable-default-padding="{{true}}"
            bindinput="onOpinionInput"
            bindblur="validateOpinion"
          />
          <text class="counter">{{form.opinion.length}}/200</text>
        </view>
        <text class="error" wx:if="{{errors.opinion}}">{{errors.opinion}}</text>
      </view>

      <view class="btn-row">
        <button
          class="btn btn-reset"
          hover-class="btn-reset-hover"
          disabled="{{submitting}}"
          bindtap="onReset"
        >重置</button>
        <button
          class="btn btn-submit"
          hover-class="btn-submit-hover"
          disabled="{{submitting}}"
          bindtap="onSubmit"
        >{{submitting ? '提交中...' : '提交问卷'}}</button>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="form-card">
      <text class="result-title">提交成功！</text>

      <view class="result-item">
        <text class="result-label">姓名：</text>
        <text class="result-value">{{result.name}}</text>
      </view>
      <view class="result-item">
        <text class="result-label">性别：</text>
        <text class="result-value">{{result.gender}}</text>
      </view>
      <view class="result-item">
        <text class="result-label">学历：</text>
        <text class="result-value">{{result.education}}</text>
      </view>
      <view class="result-item">
        <text class="result-label">技能：</text>
        <text class="result-value">{{result.skillsText}}</text>
      </view>
      <view class="result-item">
        <text class="result-label">意见：</text>
        <text class="result-value">{{result.opinion}}</text>
      </view>

      <text class="result-tip">这份问卷已保存。重新填写会新开一份，不会覆盖它。</text>
      <button class="btn btn-submit btn-rewrite" hover-class="btn-submit-hover" bindtap="onRewrite">重新填写</button>
    </view>
  </block>

  <view class="history" wx:if="{{records.length}}">
    <text class="history-title">已提交问卷（{{records.length}}）</text>
    <view class="history-card" wx:for="{{records}}" wx:key="id">
      <view class="history-head">
        <text class="history-name">{{item.name}}</text>
        <text class="history-time">{{item.timeText}}</text>
      </view>
      <view class="result-item">
        <text class="result-label">性别：</text>
        <text class="result-value">{{item.gender}}</text>
      </view>
      <view class="result-item">
        <text class="result-label">学历：</text>
        <text class="result-value">{{item.education}}</text>
      </view>
      <view class="result-item">
        <text class="result-label">技能：</text>
        <text class="result-value">{{item.skillsText}}</text>
      </view>
      <view class="result-item">
        <text class="result-label">意见：</text>
        <text class="result-value">{{item.opinion}}</text>
      </view>
      <button
        class="btn-delete"
        hover-class="btn-delete-hover"
        data-id="{{item.id}}"
        bindtap="onDeleteRecord"
      >删除</button>
    </view>
  </view>
</view>
