<view class="page">
  <view class="toolbar">
    <button class="manage-btn" bindtap="onManage">商品管理</button>
    <button
      class="refresh-btn"
      disabled="{{loading}}"
      bindtap="onRefresh"
    >刷新列表</button>
  </view>

  <view class="empty" wx:if="{{loaded && goodsList.length === 0}}">暂无二手商品</view>

  <view class="list" wx:elif="{{goodsList.length > 0}}">
    <view
      class="goods-item"
      wx:for="{{goodsList}}"
      wx:key="id"
      data-id="{{item.id}}"
      data-name="{{item.name}}"
      data-price="{{item.price}}"
      data-status="{{item.status}}"
      bindtap="onGoodsTap"
    >
      <image class="goods-img" src="{{item.image}}" mode="aspectFit"></image>
      <view class="goods-info">
        <text class="goods-name">{{item.name}}</text>
        <text class="goods-price">¥{{item.price}}</text>
      </view>
      <view class="badge" wx:if="{{item.price <= 50}}">超值</view>
      <view class="sold-mask" wx:if="{{item.status === 'sold'}}">
        <text class="sold-text">已售出</text>
      </view>
    </view>
  </view>
</view>
