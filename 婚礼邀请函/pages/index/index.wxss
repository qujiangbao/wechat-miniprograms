.bg {
  width: 100vw;
  height: 100vh;
  position: fixed;
  left: 0;
  top: 0;
  z-index: 0;
}

.content {
  position: relative;
  z-index: 1;
  width: 100vw;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  padding: 2vh 0 calc(64px + env(safe-area-inset-bottom));
}

.content-gif {
  width: 16vh;
  height: 15vh;
  margin-bottom: 1vh;
}

.content-title {
  font-size: 4.6vh;
  color: #ff4c91;
  text-align: center;
  margin-bottom: 1.6vh;
  letter-spacing: 0.4vh;
}

.content-avatar image {
  width: 20vh;
  height: 20vh;
  border: 3px solid #ff4c91;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.65);
}

.content-info {
  width: 78vw;
  margin-top: 3vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.content-name {
  color: #ff4c91;
  font-size: 2.6vh;
  line-height: 4vh;
  font-weight: bold;
  text-align: center;
  position: relative;
  padding: 0 4vh;
}

.content-name .role {
  font-weight: normal;
  font-size: 2.2vh;
}

.content-name > image {
  width: 2.8vh;
  height: 2.8vh;
  border: 1px solid #ff4c91;
  border-radius: 50%;
  position: absolute;
  top: -0.6vh;
  right: 0.4vh;
  background: #ffffff;
}

.content-wedding {
  width: 8vh;
  display: flex;
  justify-content: center;
}

.content-wedding image {
  width: 5.5vh;
  height: 5.5vh;
}

.content-address {
  margin-top: 3.2vh;
  color: #ec5f89;
  font-size: 2.4vh;
  font-weight: bold;
  text-align: center;
  line-height: 4.2vh;
}

.content-address view:first-child {
  font-size: 2.8vh;
  padding-bottom: 1vh;
}
