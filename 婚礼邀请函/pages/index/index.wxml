<image class="bg" src="/images/bg_1.png" mode="aspectFill"></image>

<view class="content">
  <image class="content-gif" src="/images/save_the_date.gif" mode="aspectFit"></image>
  <view class="content-title">邀请函</view>

  <view class="content-avatar">
    <image src="/images/avatar.png" mode="aspectFit"></image>
  </view>

  <view class="content-info">
    <view class="content-name" bindtap="callGroom">
      <image src="/images/tel.png" mode="aspectFit"></image>
      <view>陈汭</view>
      <view class="role">新郎</view>
    </view>
    <view class="content-wedding">
      <image src="/images/wedding.png" mode="aspectFit"></image>
    </view>
    <view class="content-name" bindtap="callBride">
      <image src="/images/tel.png" mode="aspectFit"></image>
      <view>xxx</view>
      <view class="role">新娘</view>
    </view>
  </view>

  <view class="content-address">
    <view>我们诚邀您来参加我们的婚礼</view>
    <view>时间：2026年10月8日</view>
    <view>地点：北京市海淀区XX路XX酒店</view>
  </view>
</view>
