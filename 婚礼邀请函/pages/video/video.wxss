.video-page {
  min-height: 100%;
  background: #f7f7f7;
  padding: 16rpx 0 40rpx;
  box-sizing: border-box;
}

.video {
  box-shadow: 0 8rpx 17rpx 0 rgba(7, 17, 27, 0.1);
  margin: 16rpx 25rpx 0;
  padding: 20rpx;
  border-radius: 10rpx;
  background: #ffffff;
}

.video:last-child {
  margin-bottom: 30rpx;
}

.video-title {
  font-size: 35rpx;
  color: #333333;
}

.video-time {
  font-size: 26rpx;
  color: #979797;
  margin-top: 6rpx;
}

.video video {
  width: 100%;
  height: 380rpx;
  margin-top: 20rpx;
  border-radius: 8rpx;
  background: #111111;
}
