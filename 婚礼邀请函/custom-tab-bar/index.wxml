<view class="tab-bar">
  <view
    class="tab-item"
    wx:for="{{list}}"
    wx:key="pagePath"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <image class="tab-icon" src="{{item.icon}}" mode="aspectFit"></image>
    <text class="tab-text" style="color: {{selected === index ? selectedColor : color}}">{{item.text}}</text>
  </view>
</view>
