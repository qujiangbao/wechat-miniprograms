.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  height: calc(48px + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #ffffff;
  border-top: 1rpx solid #eeeeee;
  box-sizing: border-box;
  z-index: 10000;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tab-icon {
  width: 46rpx;
  height: 46rpx;
}

.tab-text {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 1.2;
}
