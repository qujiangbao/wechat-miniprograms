.page {
  min-height: 100vh;
  padding-bottom: 24rpx;
  box-sizing: border-box;
}

.shop-item {
  display: flex;
  padding: 15rpx;
  border: 1rpx solid #cc8c8c;
  border-radius: 8rpx;
  margin: 15rpx;
  background-color: #ffffff;
  box-shadow: 1rpx 1rpx 15rpx rgb(196, 130, 130);
}

.thumb image {
  width: 250rpx;
  height: 250rpx;
  display: block;
  margin-right: 15rpx;
  border-radius: 8rpx;
  background-color: #f3e6e6;
  flex-shrink: 0;
}

.info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-around;
  font-size: 24rpx;
  color: #555555;
  line-height: 1.5;
}

.info text {
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  word-break: break-all;
}

.shop-title {
  font-weight: bold;
  font-size: 32rpx;
  color: #333333;
  -webkit-line-clamp: 1;
}

.footer {
  padding: 10rpx 0 30rpx;
  text-align: center;
  font-size: 24rpx;
  color: #999999;
}
